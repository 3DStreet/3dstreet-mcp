{
  "name": "3dstreet-mcp",
  "version": "0.2.2",
  "mcpName": "app.3dstreet/3dstreet",
  "description": "Fallback MCP relay for 3DStreet: drive an open 3DStreet tab from clients without WebMCP (Claude Desktop, Claude Code). Browser-embedded agents should use WebMCP directly at https://3dstreet.app — nothing to install.",
  "type": "module",
  "main": "src/relay.js",
  "exports": {
    ".": "./src/relay.js"
  },
  "bin": {
    "3dstreet-mcp": "src/cli.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "AGPL-3.0-or-later",
  "author": "3DStreet contributors",
  "homepage": "https://github.com/3DStreet/3dstreet-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3DStreet/3dstreet-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/3DStreet/3dstreet/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "3dstreet",
    "claude",
    "anthropic",
    "aframe",
    "urban-planning"
  ],
  "dependencies": {
    "ws": "^8.20.0"
  }
}
